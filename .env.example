# Supabase (OPTIONAL — get from supabase.com > Your Project > Settings > API)
#
# As of 2026-05 the app runs local-first: a stable per-device UUID
# (persisted in localStorage) is the default identity. Sign-in is opt-in
# from Settings → Account ("Sign in to sync"). If these env vars are
# missing OR the Supabase project is unreachable, the Sign-in button is
# disabled with a note explaining sync isn't available — the rest of the
# app keeps working entirely offline via Dexie.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Dev bypass: set to 'true' to skip auth in development and mount a
# hardcoded `dev-user`. Useful when you want a stable id across reloads
# instead of the per-browser local UUID.
# VITE_DEV_BYPASS=true

# Local plan generator (default: enabled). The on-device rule-based
# planner is the production path — it generates plans without any backend
# round-trip and works fully offline. Set to 'false' ONLY for one-off
# comparison against the deprecated edge `generate_plan` op.
# VITE_USE_LOCAL_PLANNER=false

# (Removed 2026-04-20) VITE_GEMINI_API_KEY is no longer used. Image-based
# exercise extraction now runs server-side via Claude Opus 4.7 on the
# `extract_exercises` edge-function op — no browser-side LLM key required.
